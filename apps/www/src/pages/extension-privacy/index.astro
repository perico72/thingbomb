import Header from "../../components/Header.astro";
import Button from "../../components/Button.astro";
import Footer from "../../components/Footer.astro";
import { SITE_TITLE } from "../../consts";
import BaseHead from "../../components/BaseHead.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Extension Privacy Policy - Flowtide"
      description="Learn more about our privacy practices related to the Flowtide browser extension. Our privacy policies are simple and easy to read."
    />
  </head>
  <body class="bg-black">
    <Header title={SITE_TITLE} />

    <div
      class="p-6 bg-black text-white flex justify-center pt-10 animate-fade-in opacity-0
        [--animation-delay:200ms]"
    >
      <article class="space-y-6 w-full max-w-2xl">
        <h1 class="text-2xl font-bold">Extension Privacy Policy</h1>

        <p class="text-base font-semibold">
          In short: Flowtide's extension does not store any personally
          identifiable information (PII) about or from you. Cloudflare may
          collect your IP address when using background images from their CDN to
          improve performance and security. If you use weather, Open-Meteo may
          collect location data.
        </p>

        <p class="text-base font-semibold">Scope</p>
        <p class="text-base">
          This privacy policy applies to the Flowtide browser extension and the
          online demo (https://demo.flowtide.app).
        </p>

        <p class="text-base font-semibold">Terms</p>
        <ul class="list-disc pl-6 space-y-2">
          <li>
            <p class="text-base font-semibold">Flowtide</p>
            <p class="text-base">– The Flowtide browser extension/demo site</p>
          </li>
          <li>
            <p class="text-base font-semibold">We/Us</p>
            <p class="text-base">– The developer of Flowtide</p>
          </li>
          <li>
            <p class="text-base font-semibold">PII</p>
            <p class="text-base">– Personally identifiable information</p>
          </li>
          <li>
            <p class="text-base font-semibold">CDN</p>
            <p class="text-base">
              – Content Delivery Network - a distributed network of servers
            </p>
          </li>
        </ul>

        <h2 class="text-xl font-bold">Data Usage</h2>

        <p class="text-base font-semibold">Image Hosting</p>
        <p class="text-base">
          Flowtide uses Cloudflare’s CDN to host the wallpaper images.
          Cloudflare may collect certain data, including IP addresses and system
          configurations, for performance and security purposes. This data is
          handled by Cloudflare and is subject to their privacy policy. For more
          details, you can refer to Cloudflare's privacy policy.
        </p>
        <p class="text-base font-semibold">Weather Data</p>
        <p class="text-base">
          Flowtide uses Open-Meteo to fetch weather data. Open-Meteo may collect
          location data to provide weather information. Flowtide doesn't store
          any of your location data itself. For more details, you can refer to
          Open-Meteo's privacy policy.
        </p>

        <p class="text-base font-semibold">Last updated</p>
        <p class="text-base">February 26, 2025</p>
      </article>
    </div>
    <script src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
    <br />
    <Footer />
  </body>
</html>
