import BaseHead from "../../components/BaseHead.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Button from "../../components/Button.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../../consts";

let defaultBrowser = "chrome";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title={`Download -  ${SITE_TITLE}`}
      description={SITE_DESCRIPTION}
    />
  </head>
  <body class="bg-black">
    <Header title={SITE_TITLE} />
    <section class="pt-12 pb-20 px-4 sm:px-6 relative">
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-1 bg-clip-text h-fit
            text-transparent bg-gradient-to-r from-white to-gray-300 m-0 p-0"
        >
          Download
        </h1>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 bg-clip-text h-fit p-0 m-0
            text-transparent bg-gradient-to-r from-teal-200 to-teal-500 !leading-[70px]"
        >
          Flowtide
        </h1>
        <div class="flex flex-col gap-3 justify-center">
          <a
            href="https://www.flowtide.app/install/chrome"
            class="bg-white/10 backdrop-blur-md text-white px-4 py-3 rounded-md font-medium
              hover:bg-white/20 transition-colors border border-white/20 text-2xl"
          >
            Chrome
          </a>
          <a
            href="https://addons.mozilla.org/en-US/firefox/addon/flowtide-new-tab/"
            class="bg-white/10 backdrop-blur-md text-white px-4 py-3 rounded-md font-medium
              hover:bg-white/20 transition-colors border border-white/20 text-2xl"
          >
            Firefox
          </a>
          <a
            href="https://microsoftedge.microsoft.com/addons/detail/flowtide-beautiful-new-/pldehmgohfonmgglijmfppbhbfghiace"
            class="bg-white/10 backdrop-blur-md text-white px-4 py-3 rounded-md font-medium
              hover:bg-white/20 transition-colors border border-white/20 text-2xl"
          >
            Edge
          </a>
        </div>
      </div>
    </section>
    <br />
    <Footer />
    <script src="https://scripts.simpleanalyticscdn.com/latest.js"></script>
  </body>
</html>
