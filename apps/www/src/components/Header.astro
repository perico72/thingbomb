---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header class="mb-16">
  <nav
    class="fixed top-0 left-0 right-0 z-50 backdrop-blur-xl bg-black/40 border-b
      border-white/10"
  >
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center">
          <a href="/" class="flex items-center gap-2 text-white">
            <img src="/favicon.png" alt="Blooft Logo" class="w-7 h-7 m-0" />
            <span class="font-semibold text-lg">Blooft</span>
          </a>
        </div>

        <div class="hidden md:flex items-center space-x-8">
          <a href="/plugins" class="text-gray-300 hover:text-white text-sm">
            Plugins
          </a>
          <a href="/stashnetic" class="text-gray-300 hover:text-white text-sm">
            Stashnetic
          </a>
          <a href="/blog" class="text-gray-300 hover:text-white text-sm">
            Blog
          </a>
        </div>

        <div class="flex items-center space-x-4">
          <a
            href="https://github.com/blooft-app/blooft"
            class="text-sm text-gray-300 hover:text-white flex items-center gap-1"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
              >
              </path>
            </svg>
            GitHub
          </a>
          <a
            href="https://demo.blooft.com"
            class="text-sm text-gray-300 hover:text-white"
          >
            Try demo
          </a>
          <a
            href="/install"
            class="text-sm bg-white text-black px-3 py-1.5 rounded-md hover:bg-gray-200
              transition-colors"
          >
            Install
          </a>
        </div>
      </div>
    </div>
  </nav>
</header>
