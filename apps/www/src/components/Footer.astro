---
import { SITE_TITLE } from "../consts";
---

<footer class="py-12 px-4 sm:px-6 border-t border-white/10">
  <div class="max-w-7xl mx-auto">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <div>
        <h3 class="font-semibold mb-4">Resources</h3>
        <ul class="space-y-2">
          <li>
            <a href="/blog" class="text-sm text-gray-400 hover:text-white">
              Blog
            </a>
          </li>
          <li>
            <a href="/help" class="text-sm text-gray-400 hover:text-white">
              Help Center
            </a>
          </li>
          <li>
            <a
              href="mailto:hello@thingbomb.com"
              class="text-sm text-gray-400 hover:text-white"
            >
              Contact us
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4">Privacy</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="/extension-privacy"
              class="text-sm text-gray-400 hover:text-white"
            >
              Extension privacy policy
            </a>
          </li>
          <li>
            <a
              href="/website-privacy"
              class="text-sm text-gray-400 hover:text-white"
            >
              Website privacy policy
            </a>
          </li>
        </ul>
      </div>
      <div>
        <h3 class="font-semibold mb-4">Connect</h3>
        <ul class="space-y-2">
          <li>
            <a
              href="https://bsky.app/profile/flowtide.app"
              class="text-sm text-gray-400 hover:text-white"
            >
              Bluesky
            </a>
          </li>
          <li>
            <a
              href="https://github.com/thingbomb/flowtide"
              class="text-sm text-gray-400 hover:text-white"
            >
              GitHub
            </a>
          </li>
          <li>
            <a
              href="https://discord.gg/hhPuurkvua"
              class="text-sm text-gray-400 hover:text-white"
            >
              Discord
            </a>
          </li>
          <li>
            <a
              href="https://feedback.flowtide.app"
              class="text-sm text-gray-400 hover:text-white"
            >
              Feedback portal
            </a>
          </li>
        </ul>
      </div>
    </div>
    <div
      class="mt-12 pt-8 border-t border-white/10 flex flex-col md:flex-row justify-between
        items-center"
    >
      <div class="flex items-center mb-4 md:mb-0">
        <a href="/" class="flex items-center gap-2 text-white">
          <img src="/favicon.png" alt="Flowtide Logo" class="w-7 h-7 m-0" />
          <span class="font-semibold">Flowtide</span>
        </a>
      </div>
    </div>
  </div>
</footer>
