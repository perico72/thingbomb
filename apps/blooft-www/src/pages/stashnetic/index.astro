---
import BaseHead from "../../components/BaseHead.astro";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead
      title="Stashnetic - Redesigned Tab Management"
      description="Save and organize your tabs with Stashnetic, a simple tool for saving and organizing your tabs. Available for the Chrome browser."
    />
  </head>
  <body
    class="bg-black text-white min-h-screen bg-gradient-to-br from-black via-neutral-900
      to-neutral-800 font-sans"
  >
    <Header />
    <section class="pt-32 pb-20 px-4 sm:px-6 relative">
      <div class="max-w-4xl mx-auto text-center relative z-10">
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-1 bg-clip-text h-fit
            text-transparent bg-gradient-to-r !leading-[70px] from-white to-gray-300 m-0 p-0"
        >
          Saving Tabs
        </h1>
        <h1
          class="text-4xl sm:text-5xl md:text-6xl font-bold mb-6 bg-clip-text h-fit p-0 m-0
            text-transparent bg-gradient-to-r from-purple-500 to-purple-800 !leading-[70px]"
        >
          Redesigned
        </h1>
        <p class="text-xl md:text-2xl text-gray-400 mb-8 max-w-2xl mx-auto">
          Stashnetic unifies tab stashing and read later with a simple interface
          for viewing your saved tabs. Easily save tabs using multiple methods.
        </p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center">
          <a
            href="https://chromewebstore.google.com/detail/stashnetic/egihopfihghnngaaffbmfoggfmdbedfc"
            class="bg-white text-black px-4 py-2 rounded-md font-medium hover:bg-gray-200
              transition-colors text-sm"
          >
            Install for Chrome
          </a>
        </div>
      </div>
    </section>

    <section class="py-20 pt-0 px-4 sm:px-6 relative">
      <div class="relative">
        <div
          class="relative backdrop-blur-xl bg-white/10 border border-white/20 rounded-2xl p-4
            shadow-2xl overflow-hidden"
        >
          <div class="aspect-[75/41] rounded-lg overflow-hidden relative">
            <div
              class="h-full w-full z-0 absolute inset-0"
              style="background-size: cover; background-color: white;"
            >
            </div>
            <img
              src="/hero-stashnetic.jpeg"
              alt="Blooft Screenshot"
              class="w-full h-auto z-10 absolute inset-0 m-0 p-0"
            />
          </div>
        </div>
      </div>
    </section>

    <Footer />
  </body>
</html>
