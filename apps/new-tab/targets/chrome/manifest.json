{
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.blooft.com/plugins/*"],
      "js": ["content.js"]
    }
  ],
  "default_locale": "en",
  "description": "Blooft is a beautiful and modern new tab page for your browser. Deep customization, modern design, tools, and more.",
  "host_permissions": ["https://www.blooft.com/*"],
  "icons": {
    "128": "assets/icon-128.png",
    "256": "assets/icon-256.png"
  },
  "manifest_version": 3,
  "name": "Blooft - Beautiful New Tab",
  "permissions": ["bookmarks", "storage"],
  "version": "4.2.2"
}
